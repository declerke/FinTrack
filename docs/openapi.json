  "components": {
    "schemas": {
      "AccessToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "AccessToken"
      },
      "AnalystPublic": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "AnalystPublic"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "ErrorContent": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorContent"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorContent"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "PortfolioCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "client_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Name"
          },
          "base_currency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ],
            "title": "Base Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "client_name",
          "base_currency"
        ],
        "title": "PortfolioCreate"
      },
      "PortfolioResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "client_name": {
            "type": "string",
            "title": "Client Name"
          },
          "base_currency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ],
            "title": "Base Currency"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "client_name",
          "base_currency",
          "created_at"
        ],
        "title": "PortfolioResponse"
      },
      "PortfolioSummary": {
        "properties": {
          "portfolio_id": {
            "type": "integer",
            "title": "Portfolio Id"
          },
          "base_currency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ],
            "title": "Base Currency"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionSummary"
            },
            "type": "array",
            "title": "Positions"
          },
          "total_invested": {
            "type": "string",
            "title": "Total Invested"
          },
          "total_value": {
            "type": "string",
            "title": "Total Value"
          }
        },
        "type": "object",
        "required": [
          "portfolio_id",
          "base_currency",
          "positions",
          "total_invested",
          "total_value"
        ],
        "title": "PortfolioSummary"
      },
      "PortfolioUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "client_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Name"
          },
          "base_currency": {
            "type": "string",
            "enum": [
              "KES",
              "USD"
            ],
            "title": "Base Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "client_name",
          "base_currency"
        ],
        "title": "PortfolioUpdate"
      },
      "PositionSummary": {
        "properties": {
          "instrument": {
            "type": "string",
            "title": "Instrument"
          },
          "net_quantity": {
            "type": "string",
            "title": "Net Quantity"
          },
          "average_cost": {
            "type": "string",
            "title": "Average Cost"
          },
          "total_invested": {
            "type": "string",
            "title": "Total Invested"
          },
          "valuation_price": {
            "type": "string",
            "title": "Valuation Price"
          },
          "total_value": {
            "type": "string",
            "title": "Total Value"
          }
        },
        "type": "object",
        "required": [
          "instrument",
          "net_quantity",
          "average_cost",
          "total_invested",
          "valuation_price",
          "total_value"
        ],
        "title": "PositionSummary"
      },
      "TransactionCreate": {
        "properties": {
          "instrument": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$",
            "title": "Instrument"
          },
          "type": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Type"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity",
            "decimal_places": 6,
            "gt": 0,
            "max_digits": 18
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price",
